# Salin menjadi bridge.env (file ini berisi token — jangan dibagikan / di-commit).

# push     = mesin mengirim sendiri ke laptop/PC ini (Fingerspot Revo Mode "Internet").
# easylink = tarik lewat Fingerspot EasyLink SDK (PC Windows).
MODE=push

# Alamat aplikasi absensi (tanpa garis miring di akhir).
APP_URL=https://absensi.contoh.go.id

# Token yang sama dengan MESIN_ABSENSI_TOKEN di server (Vercel → Environment Variables).
MESIN_ABSENSI_TOKEN=

# --- mode push ---
# Port yang diisi di mesin: Menu → Komunikasi → Jaringan → Server Port.
PUSH_PORT=8014
# "No Mesin" di menu Jaringan mesin. Kosong = terima dari mesin mana pun.
MESIN_ID=
# Seberapa sering antrian dikirim ke aplikasi (detik).
KIRIM_DETIK=15

# --- mode easylink ---
# Nomor seri mesin (Menu → Info → No Serial).
MESIN_SN=
EASYLINK_URL=http://127.0.0.1:7005
INTERVAL_DETIK=60
