# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds no secrets
!.env.local.example

# keys, certificates & service credentials
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
credentials*.json
*service-account*.json
*serviceAccount*.json
.sentryclirc
.netrc
.npmrc

# Supabase CLI local state (project ref, pooler URL, branches)
/supabase/.temp/
/supabase/.branches/
/supabase/.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent / skill tooling (local only)
/.agents/
/.claude/
/skills-lock.json

# Mesin absensi bridge: local secrets & queue
scripts/mesin-bridge/bridge.env
scripts/mesin-bridge/bridge.env.*
!scripts/mesin-bridge/bridge.env.example
scripts/mesin-bridge/antrian.json*
scripts/mesin-bridge/*.log

# Employee data that must never reach GitHub: attendance-machine logs (USB
# export AGL001.TXT etc.) and downloaded reports / payroll exports.
[Aa][Gg][Ll][0-9]*.[Tt][Xx][Tt]
*.dat
laporan-kehadiran-*.xlsx
laporan-kehadiran-*.csv
laporan-kehadiran-*.pdf
link-undangan-karyawan.csv
payroll-*.xlsx
slip-gaji-*.pdf

# logs
*.log
logs/
