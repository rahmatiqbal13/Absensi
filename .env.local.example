# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origin publik aplikasi (dipakai untuk link undangan & email), mis. https://absen.perusahaan.id
# Jika kosong di Vercel, otomatis memakai domain produksi Vercel.
NEXT_PUBLIC_APP_URL=

# Password awal 2 super admin dari `npm run seed`
SEED_SUPERADMIN_PASSWORD=

# Email (opsional — tanpa ini email dilewati, aplikasi tetap jalan)
RESEND_API_KEY=
EMAIL_FROM=

# Secret untuk /api/cron/holidays (Vercel Cron mengirimnya otomatis)
CRON_SECRET=

# Token jembatan mesin absensi kantor (scripts/mesin-bridge -> /api/mesin/scans).
# Minimal 24 karakter acak, mis. `openssl rand -hex 32`. Kosong = endpoint mati.
MESIN_ABSENSI_TOKEN=

# Secret bersama pg_cron <-> Edge Function purge-expired-photos (dibaca saat `supabase db push`)
PURGE_SHARED_SECRET=

# Error monitoring Sentry (opsional — kosong = mati). DSN dari Sentry → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
# Upload source map saat build (cukup diisi di Vercel)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
